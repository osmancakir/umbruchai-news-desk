{
  "name": "umbruchai-news-desk",
  "version": "1.0.0",
  "description": "LangGraph multi-agent news desk: five journalist personas research, pitch, write, illustrate, narrate and publish graded German news articles",
  "type": "module",
  "scripts": {
    "start": "langgraphjs dev",
    "dev": "langgraphjs dev",
    "studio": "langgraphjs dev",
    "web": "npm --prefix web run dev",
    "build:skills": "tsx src/scripts/build-skills.ts",
    "check:skills": "tsx src/scripts/build-skills.ts --check",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/openai": "^1.6.0",
    "dotenv": "^18.0.5",
    "langchain": "^1.5.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.1",
    "@types/node": "^26.6.3",
    "tsgo": "npm:typescript@^7.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
